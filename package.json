{
  "name": "@tradimation/core",
  "version": "0.1.0",
  "description": "Framework-neutral traditional-animation effects for the web",
  "homepage": "https://tradimation.github.io/tradimation/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tradimation/tradimation.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    }
  },
  "scripts": {
    "build": "pnpm build:core && pnpm build:site",
    "build:core": "tsdown",
    "build:site": "node scripts/generate-site-pages.mjs && vite build --config website/vite.config.js",
    "dev:site": "pnpm build:core && vite --config website/vite.config.js",
    "check": "pnpm lint && pnpm typecheck && pnpm build:core && pnpm test && pnpm build:site",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . && pnpm lint:site-copy",
    "lint:site-copy": "node scripts/check-site-casing.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "animation",
    "webgl",
    "waapi",
    "framework-agnostic",
    "traditional-animation"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "svelte": "^5.56.10",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
